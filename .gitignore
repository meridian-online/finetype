# quarantine_label_errors.csv likewise. Reports + memo under the same dir
# ARE tracked. *.ndjson is already covered by the global rule below.
output/value-level-labelling/scored_values.parquet
output/value-level-labelling/kept_rows.parquet
output/value-level-labelling/quarantine_label_errors.csv

