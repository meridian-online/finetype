# Rust
/target/
**/*.rs.bk
Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
._*

# Model artifacts (push to HuggingFace, decision 0014)
# Only the `default` symlink is tracked — everything else is downloaded at
# build time via .github/scripts/download-model.sh or set via FINETYPE_MODEL_DIR.
models/**/*.bin
models/**/*.safetensors
models/**/config.json
models/**/config.yaml
models/**/label_map.json
models/**/labels.json
models/**/results.json
models/**/*.jsonl
models/**/eval/
models/*.csv
models/*.json
models/*.md
!models/.gitkeep

# YDF lens artefacts under eval/gittables/models/ — regenerable from
# scripts/train_ydf.py. The model binary directory is multi-GB and the
# training-rows manifest is ~16 MB; the small JSON/vocab files stay tracked.
eval/gittables/models/ydf.bin/
eval/gittables/models/training_rows_manifest.tsv

# DBpedia annotations parquet (~96 MB) — regenerable from
# scripts/extract_dbpedia_annotations.py against corpus_paths.txt.
eval/gittables/corpus_pass/dbpedia_annotations.parquet

# Corpus-pass outputs (multi-GB) and run logs — regenerable from
# scripts/gittables_corpus_pass.py.
eval/gittables/corpus_pass/files.parquet
eval/gittables/corpus_pass/columns.parquet
eval/gittables/corpus_pass/columns.pre-ydf.parquet
eval/gittables/corpus_pass/execute_log.jsonl
eval/gittables/corpus_pass/execute_summary.json
eval/gittables/corpus_pass/fill_ydf_summary.json
eval/gittables/corpus_pass*.log
eval/gittables/corpus_pass*.run*.log
eval/gittables/corpus_pass.run*-*/

# ac-08 — per-column reject extract + intermediate path lists.
# Regenerable: criterion_b_failing_paths.txt from files.parquet via
# scripts/gate_summary_sql.sql variant; per_column_rejects.parquet
# from scripts/extract_per_column_rejects.py.
eval/gittables/corpus_pass/criterion_b_failing_paths.txt
eval/gittables/corpus_pass/per_column_rejects.parquet
eval/gittables/corpus_pass/per_column_rejects_errors.jsonl
eval/gittables/per_column_rejects.log

# ac-08 mechanism attribution log + parquet (regenerable).
# The parquet contains real gittables sample values; some incidentally
# match GitHub's secret-scanner patterns (e.g. 20-char uppercase
# alphanumeric strings parse as candidate AWS Access Key IDs).
# Regenerable from scripts/build_mechanism_decomposition.py.
eval/gittables/mechanism_decomposition.log
eval/gittables/corpus_pass/mechanism_decomposition.parquet

# ac-09 outputs (regenerable from scripts/build_corroborated_gaps.py).
# corroborated_gaps.parquet carries sample_evidence with real
# corpus values — same false-positive risk as mechanism_decomposition.
# single_lens_signals.tsv is ~240MB / 2.6M rows.
eval/gittables/corpus_pass/corroborated_gaps.parquet
eval/gittables/corpus_pass/single_lens_signals.tsv

# ac-13 reproducibility sub-pass outputs (calibrate half, 100 files).
# Regenerable via scripts/test_corpus_pass_reproducibility.sh.
# Same secret-scanner false-positive risk as the measure-half parquets.
eval/gittables/corpus_pass_calibrate_reprocheck/
eval/gittables/corpus_paths_calibrate_100.txt

# Claude scheduled-task lock file (transient)
.claude/scheduled_tasks.lock

# Generated training data
*.ndjson
!eval/datasets/**/*.ndjson
data/*
!data/cldr/
!data/label_remap.json
data/cldr/json/

# DuckDB extension build
extension/build/
*.duckdb_extension

# Python
__pycache__/
*.pyc

# Eval outputs (generated data, not source).
# Excluded as a glob (NOT the whole directory) so individual files like
# the validate-corpus baseline + post-fix reports can be tracked
# explicitly per spec 2026-04-28-validate-precision-corpus ac-14.
eval/eval_output/*.csv
eval/eval_output/*.json
eval/eval_output/*.parquet
eval/eval_output/*.db
eval/eval_output/*.tsv
eval/eval_output/*.log
eval/eval_output/profile_results.csv
eval/eval_output/actionability_results.csv

# Legacy CSV-sidecar outputs from the pre-MADR-0064 `finetype validate`
# flow. The new flow writes a single `.db` file via --db <path>; these
# patterns exist to keep stray pre-MADR-0064 runs out of git.
eval/datasets/csv/*.csv.valid.csv
eval/datasets/csv/*.csv.invalid.csv
eval/datasets/csv/*.csv.errors.jsonl
eval/datasets/csv/*.schema.json

# Spike experiment outputs
output/spike-training/
output/spike-results/

# v20 retrain artefacts (per spec 2026-05-23-ydf-specialist-geography).
# Multi-GB corpus-pass parquets + the merged distilled training input
# are regenerable from scripts/overnight_v20_geography.sh.
output/distillation-v20/
output/corpus-pass-v20/

# v21 GeoNames-sourced retrain artefacts (per spec 2026-05-24-v21-geonames-geography).
# Regenerable from scripts/overnight_v21_geonames.sh.
# The generator config (eval/geonames/) IS tracked — those YAMLs are
# the reproducible recipe; this gitignore only excludes the bulk output.
output/distillation-v21-geonames/
output/distillation-v21/
output/corpus-pass-v21/

# Distillation batch files (rolled into *_distilled.csv.gz)
output/distillation-v3/sherlock_batch_*.csv
output/distillation-v3/sherlock_batch_*.done
output/distillation-v3/distill_concat.log
output/distillation-v3/*_distilled.csv.gz

# v17: per-type v4 distilled CSVs are reproducible via loaders/*.py;
# track the loaders + SOURCES.md, not the CSVs or HTTP cache.
output/distillation-v4/*.csv
output/distillation-v4/loaders/_cache/
output/multibranch-training/

# Agent-generated temp scripts
classify_batch_*.py
write_batch_*.py

# External repos (submodules / symlinks)
duckdb-finetype/
homebrew-tap/

# Model directories (large binary artifacts)
models/tiered-v2/

# RunPod (credentials, ephemeral config)
.runpod_ssh.env
.runpod_config.env
budget.json

# Research (ephemeral outputs)
research/run.log
research/results.tsv
research/__pycache__/
research/.venv/

# Training result logs (ephemeral)
results/

# Claude Code worktrees
.claude/worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads-archive/
