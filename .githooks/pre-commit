#!/usr/bin/env bash
# Pre-commit hook: fast format check only, so commits stay instant.
# The heavier clippy gate runs on pre-push (see .githooks/pre-push), which is
# the precise mirror of the CI jobs that block a release.
#
# Activate (per clone):  git config core.hooksPath .githooks
set -euo pipefail

echo "══ pre-commit: cargo fmt --all -- --check ══"
cargo fmt --all -- --check

echo "══ pre-commit: format clean ══"
