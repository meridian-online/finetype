{
  "env": {
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo run *)",
      "Bash(cargo machete *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo doc *)",
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(./scripts/check_*)",
      "Bash(python3 scripts/check_*)",
      "Bash(uv run scripts/check_*)",
      "Bash(./scripts/score_*)",
      "Bash(python3 scripts/score_*)",
      "Bash(uv run scripts/score_*)",
      "Bash(./scripts/test_*)",
      "Bash(python3 scripts/test_*)",
      "Bash(uv run scripts/test_*)",
      "Bash(./target/debug/finetype *)",
      "Bash(./target/release/finetype *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status"
    ],
    "ask": [
      "Bash(make -*)",
      "Bash(make * -*)",
      "Bash(make *=*)",
      "Bash(make *setup*)",
      "Bash(git commit *--am*)",
      "Bash(git commit *--no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git fetch *--upl*)",
      "Bash(git pull *--upl*)",
      "Bash(git diff *--ou*)",
      "Bash(git log *--ou*)",
      "Bash(git show *--ou*)",
      "Bash(cargo *--con*)",
      "Bash(cargo *--target-d*)",
      "Bash(cargo *--man*)",
      "Bash(git switch *--di*)",
      "Bash(git switch *--f*)",
      "Bash(git switch * -f*)",
      "Bash(git worktree add * -B*)",
      "Bash(git worktree add *--f*)",
      "Bash(git worktree add * -f*)",
      "Bash(git worktree add -f*)",
      "Bash(git worktree add -B*)"
    ]
  }
}
